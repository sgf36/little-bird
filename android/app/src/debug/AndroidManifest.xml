<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The main manifest removes INTERNET, because the released app makes no
         network request of its own and a permission it does not use should not
         appear on the Play listing. A debug build does need it: the Dart VM
         service, hot reload and the observatory all talk over a socket, and
         without this `flutter run` attaches to nothing.

         Flutter's own template ships exactly this file for exactly this
         reason. It is a source set, so it is merged only into the debug
         variant and can never reach a release bundle. -->
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
