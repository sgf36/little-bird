<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
    <!-- Wren asks for no permissions of its own. This one arrives anyway:
         `in_app_purchase` pulls in com.android.billingclient:billing, whose
         own manifest declares BILLING, and the merged manifest is what Play
         reads. Verified in
         build/app/intermediates/merged_manifest/.../AndroidManifest.xml —
         the app manifest saying nothing is not evidence that the APK says
         nothing.

         It has to go. The unlock sells Apple Maps guides of any size, there
         is no such product in Play Console, and nothing on Android can now
         reach a paywall. Left in, Play would advertise "In-app purchases"
         on a listing that cannot take a payment.

         Safe because no BillingClient is ever constructed here: CapturePage
         builds an UnavailableUnlockStore when it cannot make guides, so the
         plugin attaches its channel and is never called. If Android ever
         does sell something, delete this line first — a billing call
         without the permission fails at connection time, not at build. -->
    <uses-permission android:name="com.android.vending.BILLING" tools:node="remove" />
    <application
        android:label="Wren"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Exports leave through a content:// URI, never a file path.
             A file:// URI grants the receiving app nothing: it launches, matches
             the MIME, tries to read and dies with EACCES. Measured against
             Organic Maps on 19 August 2026 — the intent was right and the
             transport was wrong, which is the confusing way round. -->
        <provider
            android:name=".PlaceFileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <!-- Package visibility, Android 11 and later.
         Without an entry here, a package is invisible: getPackageInfo throws
         NameNotFoundException exactly as if the app were not installed, and a
         "Send to Organic Maps" button silently never appears on a phone that has
         it. Declared per package rather than with QUERY_ALL_PACKAGES, which is a
         restricted permission needing a Play declaration we have no grounds for.

         The intent query is what makes the plain chooser work for these types. -->
    <queries>
        <!-- Every package Wren offers as a named button, and nothing else.
             These must stay in step with `namedTargets` in lib/src/map_targets.dart:
             a target listed there but missing here is a button that never appears
             on a device that has the app, because getPackageInfo throws exactly as
             if it were not installed. -->
        <package android:name="app.organicmaps" />
        <!-- Not app.organicmaps.beta: the beta build type applies no
             applicationIdSuffix, so beta installs are still app.organicmaps. -->
        <package android:name="app.organicmaps.web" />
        <package android:name="net.osmand" />
        <package android:name="net.osmand.plus" />
        <package android:name="menion.android.locus" />
        <package android:name="com.trailbehind.android.gaiagps.pro" />
        <package android:name="cz.seznam.mapy" />
        <!-- Chrome, for the Google Maps route's Custom Tab. -->
        <package android:name="com.android.chrome" />
        <!-- Enumeration for the plain chooser, which serves every app nobody has
             tested. One action per <intent>, and path/pathPrefix/pathPattern are
             forbidden inside <queries> — so "anything ending in .gpx" cannot be
             expressed here, and detection is by package name and MIME only. -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="application/gpx+xml" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/gpx+xml" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
